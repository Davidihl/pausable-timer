{
  "name": "@davidihl/pausable-timer",
  "version": "0.2.0",
  "description": "A setTimeout that can be paused and resumed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "timer",
    "timeout",
    "pause",
    "resume"
  ],
  "author": "David Ihl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davidihl/pausable-timer.git"
  },
  "homepage": "https://github.com/Davidihl/pausable-timer#readme",
  "bugs": {
    "url": "https://github.com/Davidihl/pausable-timer/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
